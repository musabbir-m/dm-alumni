# Copy to .env.local and fill in real values. .env.local is gitignored.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/dm-alumni

# Clerk — from dashboard.clerk.com (API Keys → development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk route/redirect URLs (custom pages wired in src/app/sign-in + sign-up)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register

# Email for the first admin record created by `npm run seed` — the matching
# Clerk user is created in the Clerk dashboard and links on first sign-in.
ADMIN_EMAIL=admin@dm-alumni.local

# Cloudinary (registration uploads) — from the Cloudinary console's "API keys"
# section, as-is: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
