# Copy to .env.local and fill in real values. .env.local is gitignored.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/dm-alumni

# Secret used to sign Auth.js session tokens — generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Credentials for the first admin account created by `npm run seed`
ADMIN_EMAIL=admin@dm-alumni.local
ADMIN_PASSWORD=ChangeMe!2026

# Cloudinary (registration uploads) — from the Cloudinary console's "API keys"
# section, as-is: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
